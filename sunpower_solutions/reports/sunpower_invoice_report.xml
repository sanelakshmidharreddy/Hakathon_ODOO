<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_sunpower_invoice" model="ir.actions.report">
        <field name="name">Customer Tax Invoice</field>
        <field name="model">sunpower.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sunpower_solutions.report_sunpower_invoice_document</field>
        <field name="report_file">sunpower_solutions.report_sunpower_invoice_document</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_sunpower_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sunpower_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sunpower_solutions.sunpower_external_layout">
                    <div class="page">
                        <table style="width: 100%; margin-bottom: 25px;">
                            <tr>
                                <td style="width: 50%; vertical-align: top;">
                                    <h4 style="color: #005a9c; margin: 0 0 8px;">BILLED TO:</h4>
                                    <div style="font-size: 14px; font-weight: bold;"><t t-esc="doc.customer_id.name"/></div>
                                    <div><t t-esc="doc.customer_id.street or ''"/></div>
                                    <div><t t-esc="doc.customer_id.city or ''"/>, <t t-esc="doc.customer_id.state or ''"/></div>
                                    <div>Phone: <t t-esc="doc.customer_id.phone or ''"/></div>
                                </td>
                                <td style="width: 50%; vertical-align: top; text-align: right;">
                                    <h3 style="color: #111827; margin: 0;">TAX INVOICE</h3>
                                    <div style="font-size: 13px; color: #4b5563; margin-top: 4px;">Invoice #: <strong><t t-esc="doc.name"/></strong></div>
                                    <div>Order Ref: <strong><t t-esc="doc.order_id.name"/></strong></div>
                                    <div>Invoice Date: <t t-esc="doc.invoice_date"/></div>
                                    <div>Due Date: <t t-esc="doc.due_date"/></div>
                                    <div style="margin-top: 6px;">
                                        Status: <span style="font-weight: bold; text-transform: uppercase; color: #16a34a;" t-if="doc.state == 'paid'">PAID</span>
                                        <span style="font-weight: bold; text-transform: uppercase; color: #ea580c;" t-elif="doc.state == 'posted'">PAYMENT PENDING</span>
                                        <span style="font-weight: bold; text-transform: uppercase; color: #dc2626;" t-else=""><t t-esc="doc.state"/></span>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
                            <thead>
                                <tr style="background: #005a9c; color: white; text-align: left; font-size: 11px;">
                                    <th style="padding: 8px;">Description</th>
                                    <th style="padding: 8px; text-align: right;">Amount (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #e5e7eb;">
                                    <td style="padding: 12px 8px;">
                                        <strong>Turnkey Rooftop Solar Energy System</strong>
                                        <div style="color: #6b7280; font-size: 11px; margin-top: 4px;">
                                            Capacity: <t t-esc="doc.order_id.quote_id.capacity"/> kWp (<t t-esc="doc.order_id.quote_id.system_type.replace('_', ' ')"/>) &bull; Includes Tier 1 hardware supply, structural mounting, electrical balance of system, civil work, DISCOM synchronization, and 20-year asset warranty activation.
                                        </div>
                                    </td>
                                    <td style="padding: 12px 8px; text-align: right; font-weight: bold; font-size: 13px;">
                                        ₹ <t t-esc="'{:,.2f}'.format(doc.amount_total)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table style="width: 100%;">
                            <tr>
                                <td style="width: 55%; vertical-align: top;">
                                    <div style="border: 1px solid #e5e7eb; padding: 12px; border-radius: 4px; background: #fafafa; font-size: 11px;">
                                        <h5 style="margin: 0 0 6px; color: #005a9c;">Bank Transfer Coordinates:</h5>
                                        <div><strong>Beneficiary:</strong> SunPower Solutions Pvt Ltd</div>
                                        <div><strong>Bank:</strong> HDFC Bank Ltd, Indiranagar Branch</div>
                                        <div><strong>Account No:</strong> 50200084920194</div>
                                        <div><strong>IFSC Code:</strong> HDFC0000184</div>
                                        <div><strong>UPI ID:</strong> sunpowersolar@hdfcbank</div>
                                    </div>
                                </td>
                                <td style="width: 45%; vertical-align: top;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="padding: 5px 8px; text-align: right;">Total Invoice Value:</td>
                                            <td style="padding: 5px 8px; text-align: right; font-weight: bold;">₹ <t t-esc="'{:,.2f}'.format(doc.amount_total)"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px 8px; text-align: right; color: #16a34a;">Amount Paid to Date:</td>
                                            <td style="padding: 5px 8px; text-align: right; font-weight: bold; color: #16a34a;">₹ <t t-esc="'{:,.2f}'.format(doc.amount_paid)"/></td>
                                        </tr>
                                        <tr style="border-top: 2px solid #005a9c; background: #eff6ff;">
                                            <td style="padding: 8px; text-align: right; font-weight: bold; font-size: 13px; color: #005a9c;">Balance Due:</td>
                                            <td style="padding: 8px; text-align: right; font-weight: bold; font-size: 13px; color: #005a9c;">₹ <t t-esc="'{:,.2f}'.format(doc.balance_amount)"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
