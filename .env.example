# ====================================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# Add in Vercel Project Settings -> Environment Variables
# (Apply to Production, Preview, Development)
# ====================================================================
VITE_API_BASE_URL=https://hakathon-odoo.onrender.com

# Deployment Base Path ('/' for root domain)
VITE_BASE_PATH=/

# Optional: OpenWeatherMap API Key for live weather & rain warnings
VITE_OPENWEATHER_API_KEY=

# Public Solar / Geocoding Endpoints (No API key needed)
VITE_NASA_POWER_ENDPOINT=https://power.larc.nasa.gov/api/temporal
VITE_OSM_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org

# ====================================================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# Add in Render Service Settings -> Environment Variables
# ====================================================================
FRONTEND_URL=https://hakathonodoo.vercel.app
CORS_ORIGIN=https://hakathonodoo.vercel.app
NODE_ENV=production
PORT=5000
