<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_sunpower_invoice_tree" model="ir.ui.view">
        <field name="name">sunpower.invoice.tree</field>
        <field name="model">sunpower.invoice</field>
        <field name="arch" type="xml">
            <tree string="Invoices" decoration-info="state == 'draft'" decoration-warning="state == 'posted'" decoration-success="state == 'paid'" decoration-danger="state == 'overdue'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="order_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="amount_total" widget="monetary" sum="Total Invoiced"/>
                <field name="amount_paid" widget="monetary" sum="Total Paid"/>
                <field name="balance_amount" widget="monetary" sum="Outstanding Balance"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'posted'" decoration-success="state == 'paid'" decoration-danger="state == 'overdue'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sunpower_invoice_form" model="ir.ui.view">
        <field name="name">sunpower.invoice.form</field>
        <field name="model">sunpower.invoice</field>
        <field name="arch" type="xml">
            <form string="Customer Invoice">
                <header>
                    <button name="action_post" string="Confirm &amp; Post" type="object" states="draft" class="oe_highlight"/>
                    <button name="action_register_payment" string="Register Payment" type="object" states="posted,overdue" class="oe_highlight"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object" states="posted,overdue" class="btn-success"/>
                    <button name="action_cancel" string="Cancel Invoice" type="object" states="draft,posted"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Invoice Number</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer Information">
                            <field name="customer_id" options="{'no_create': True}"/>
                            <field name="order_id" domain="[('customer_id', '=', customer_id)]"/>
                        </group>
                        <group string="Billing Dates">
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment History &amp; Receipts" name="payments">
                            <field name="payment_ids">
                                <tree string="Payments" editable="bottom">
                                    <field name="payment_date"/>
                                    <field name="payment_mode"/>
                                    <field name="reference"/>
                                    <field name="amount" sum="Total Received"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" widget="monetary"/>
                                <field name="amount_paid" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="balance_amount"/>
                                </div>
                                <field name="balance_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sunpower_invoice_search" model="ir.ui.view">
        <field name="name">sunpower.invoice.search</field>
        <field name="model">sunpower.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Invoices">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="order_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted / Unpaid" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Overdue" name="overdue" domain="[('state', '=', 'overdue')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Invoice Date" name="group_inv_date" context="{'group_by': 'invoice_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sunpower_invoice" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">sunpower.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sunpower_invoice_search"/>
        <field name="context">{'search_default_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Invoices generated automatically upon sales order confirmation.
            </p>
        </field>
    </record>
</odoo>
