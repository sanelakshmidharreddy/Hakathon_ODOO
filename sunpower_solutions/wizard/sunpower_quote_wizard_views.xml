<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunpower_quote_wizard_form" model="ir.ui.view">
        <field name="name">sunpower.quote.wizard.form</field>
        <field name="model">sunpower.quote.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Generate Solar Proposal">
                <group>
                    <group string="Customer &amp; Capacity">
                        <field name="lead_id" readonly="1"/>
                        <field name="customer_id" readonly="1"/>
                        <field name="system_type"/>
                        <field name="capacity"/>
                    </group>
                    <group string="Pricing Adjustment">
                        <field name="discount_amount"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_quote" string="Generate Auto-BOM Quotation" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sunpower_quote_wizard" model="ir.actions.act_window">
        <field name="name">Generate Solar Quote</field>
        <field name="res_model">sunpower.quote.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
