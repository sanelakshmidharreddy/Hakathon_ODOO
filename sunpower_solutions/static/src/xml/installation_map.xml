<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sunpower_solutions.InstallationMapWidget" owl="1">
        <div class="sunpower_map_container rounded border overflow-hidden shadow-sm" t-ref="mapContainer">
            <div class="bg-light px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                <span class="small font-weight-bold text-dark">
                    <i class="fa fa-map-marker text-danger me-1"/> OpenStreetMap Geolocation Coordinates
                </span>
                <span class="badge bg-secondary font-monospace">
                    Lat: <t t-esc="latitude.toFixed(4)"/>, Lon: <t t-esc="longitude.toFixed(4)"/>
                </span>
            </div>
            <iframe width="100%"
                    height="240"
                    frameborder="0"
                    scrolling="no"
                    marginheight="0"
                    marginwidth="0"
                    t-att-src="mapUrl"
                    style="border: 0; display: block;"/>
        </div>
    </t>
</templates>
