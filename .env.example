# SunPower Solutions Environment Variables Template

# Optional: OpenWeatherMap API Key for live short-term 5-day weather & rain warnings
# Register free at https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# Public free endpoints (No API keys required)
VITE_NASA_POWER_ENDPOINT=https://power.larc.nasa.gov/api/temporal
VITE_OSM_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org

# Backend API Base URL (leave blank for relative /api in production, or set e.g. https://api.sunpower.example.com)
VITE_API_BASE_URL=

# Deployment Base Path (use '/' for root domain or '/sunpower/' for sub-path deployment)
VITE_BASE_PATH=/
